# /etc/freepbx-mcp.env — read by freepbx-mcp at startup (mode 0640, group asterisk).
# Variables already set in the environment win over this file.

FREEPBX_AMI_HOST=127.0.0.1
FREEPBX_AMI_PORT=5038
FREEPBX_AMI_USER=hermes
FREEPBX_AMI_SECRET=CHANGE_ME

# Dialing policy. The defaults only allow internal extensions (2-6 digits)
# and always refuse international/premium prefixes. To let Hermes call
# local mobile numbers too, widen the allow list, e.g. for 10-digit numbers
# starting with 0:
#   FREEPBX_DIAL_ALLOW=^([0-9]{2,6}|0[0-9]{9})$
FREEPBX_DIAL_ALLOW=^[0-9]{2,6}$
FREEPBX_DIAL_DENY=^(\+|00|011|900|1900)
FREEPBX_MAX_CALLS_PER_HOUR=20

# Caller ID name shown on calls Hermes places.
FREEPBX_CALLER_ID=Hermes
# Dialplan context calls are placed through; from-internal applies your
# FreePBX outbound routes exactly like a desk phone would.
FREEPBX_DIAL_CONTEXT=from-internal

# Set to 1 to expose monitoring only (no calls, no hangups).
FREEPBX_READ_ONLY=0

FREEPBX_ASTERISK_LOG=/var/log/asterisk/full
FREEPBX_CDR_CSV=/var/log/asterisk/cdr-csv/Master.csv
